# Copy to `.env` and fill in with YOUR OWN deployment (your backend, frontend and test accounts).
# `.env` is git-ignored and must never be committed. Real environment variables always
# override `.env`, so CI supplies these as repository variables/secrets without a file at all.

# Required: where YOUR frontend is served and YOUR backend API (including the stage, e.g. .../develop).
UI_URL=
API_URL=

# Optional: Playwright/run behavior. Defaults shown are what Settings.cs falls back to.
BROWSER=
HEADLESS=
DEFAULT_TIMEOUT_MS=
NAVIGATION_TIMEOUT_MS=
TRACE_MODE=
PERF_PAGE_LOAD_MS=
PERF_API_RESPONSE_MS=
MAX_PARALLEL_TESTS=

# Optional: a standing Waiter account (register() always yields a Customer, so
# this cannot be self-provisioned). Scenarios that need it ("Given the standing
# waiter account is configured", and every seeding/cleanup step) fail fast with
# a clear message while it's unset.
WAITER_USERNAME=
WAITER_PASSWORD=

# Optional: a standing Admin account. Not yet available for this framework;
# Admin-gated scenarios stay skipped until these are filled in.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: a pre-existing table id, plus the credentials of the waiter it is
# assigned to. Lets the "only the assigned waiter may confirm/cancel" business
# rule be tested deterministically instead of discovering an assignment at runtime.
TESTTABLE_ID=
TESTTABLE_WAITER_USERNAME=
TESTTABLE_WAITER_PASSWORD=

# Required for the group pre-order scenarios (Features/GroupPreOrder*.feature):
# the customer who books the group reservations ("the owner") and a second customer who is not the owner.
# Register both once with POST /register (or the sign-up page) in YOUR environment.
CUSTOMER_USERNAME=
CUSTOMER_PASSWORD=
OTHER_CUSTOMER_USERNAME=
OTHER_CUSTOMER_PASSWORD=
# The group pre-order scenarios also use TESTTABLE_ID (a table that seats at least 5) and
# TESTTABLE_WAITER_* (the waiter of that table's location), and WAITER_* as a waiter of ANOTHER location.

# Optional: Report Portal. The agent reports only when RP__ENABLED=true.
RP__ENABLED=
RP__SERVER__URL=
RP__SERVER__PROJECT=
RP__SERVER__APIKEY=

# Optional: where run output (reports, traces) goes. Defaults to ./TestResults in the project folder.
ARTIFACTS_DIR=

# Optional: set to true to skip the pre-run sweep of leftover "AQA-Sample-" records.
SKIP_PRE_RUN_CLEANUP=
